{{!-- A line of a list of notifications, as notificationLines() makes it (see routes/views/index.ts):
  what it says, then what came out of it, if anything (see notifications/outcomes.ts). Its first line shows, with the date,
  the rest is out of sight until it's asked for. Drawn again by the server when it changes: see activity/page.ts. --}}
{{#*inline "date"}}
  <time datetime="{{dateString mtime "iso"}}">{{dateString mtime}}</time>
{{/inline}}
{{#*inline "outcomeLine"}}
  {{#if scene}}
    {{#with scene}}
      <span class="notifications-scene">
        {{#if action}}
          <span class="notifications-action">{{action}}</span>
        {{/if}}
        <a title="{{name}}" href="/ui/scenes/{{encodeURIComponent name}}">{{name}}</a>
        <span class="notifications-tools">
          <a class="tool-link" href="/ui/scenes/{{encodeURIComponent name}}/view">
            <ui-icon name="eye"></ui-icon>
            <span class="tool-text">{{i18n "labels.view"}}</span>
          </a>
          {{#if editable}}
            <a class="tool-link" href="/ui/scenes/{{encodeURIComponent name}}/edit">
              <ui-icon name="edit"></ui-icon>
              <span class="tool-text">{{i18n "labels.edit"}}</span>
            </a>
          {{else}}
            {{!-- Keeps "view" in line with those of scenes that can be edited, if there are any: see activity.scss --}}
            <span class="tool-link tool-placeholder" aria-hidden="true">
              <ui-icon name="edit"></ui-icon>
              <span class="tool-text">{{i18n "labels.edit"}}</span>
            </span>
          {{/if}}
        </span>
      </span>
    {{/with}}
  {{else}}
    <span title="{{text}}" class="notifications-text{{#if error}} text-error{{/if}}">{{text}}</span>
  {{/if}}
{{/inline}}
<li class="{{state}}" data-notification-id="{{notification_id}}">
  <ui-icon class="{{iconClass}}" name="{{icon}}"></ui-icon>
  <div class="notifications-content">
    {{#if link}}
      <a href="{{link}}">{{message}}</a>
    {{else}}
      <span>{{message}}</span>
    {{/if}}
    {{#if outcome.rest.length}}
      <details class="notifications-outcome">
        <summary>{{> outcomeLine outcome.first }}{{> date }}</summary>
        <ul>
          {{#each outcome.rest}}
            <li>{{> outcomeLine }}</li>
          {{/each}}
        </ul>
      </details>
    {{else if outcome}}
      <div class="notifications-outcome">{{> outcomeLine outcome.first }}{{> date }}</div>
    {{else}}
      {{> date }}
    {{/if}}
  </div>
  {{#if (test state "==" "unread")}}
    <button class="btn btn-transparent btn-icon notifications-mark-read" type="button" title="{{i18n "buttons.markAsRead"}}" aria-label="{{i18n "buttons.markAsRead"}}"><ui-icon name="check-check"></ui-icon></button>
  {{/if}}
</li>
