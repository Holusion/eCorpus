<li aria-labelledby="task-{{task_id}}-title task-{{task_id}}-details task-{{task_id}}-status">
  {{#if children.length}}
    <details>
      <summary>{{> taskRowContent }}</summary>
      <ul class="task-rows">
        {{#each children}}
          {{> taskRow }}
        {{/each}}
      </ul>
    </details>
  {{else}}
    {{> taskRowContent }}
  {{/if}}
</li>
