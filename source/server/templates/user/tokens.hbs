<section class="user-tokens">
  <h3>{{i18n "titles.userTokens"}}</h3>
  <p>{{i18n "leads.userTokens"}}</p>

  <form id="token-create" class="form-control" autocomplete="off">
    <div class="form-group">
      <div class="form-item">
        <label for="token-name">{{i18n "fields.name"}}</label>
        <input type="text" name="name" id="token-name" required>
      </div>
      <div class="form-item">
        <label>{{i18n "labels.scope"}}</label>
        <div id="token-scope" class="scope-slider">
          <div class="scope-slider-head">
            <label class="scope-all"><input type="checkbox" name="scope" value="all"> <span>all</span></label>
            <span class="scope-hint">{{i18n "leads.scopeHint"}}</span>
          </div>
          <div class="scope-head" aria-hidden="true">
            <span class="scope-head-origin"></span>
            <span>read</span>
            <span>write</span>
            <span>admin</span>
          </div>
          {{#each scopeFamilies}}
          <fieldset class="scope-lane">
            <legend>{{family}}</legend>
            <div class="scope-track">
              <label class="origin" title="{{i18n "labels.noAccess"}}">
                <input type="radio" name="scope:{{family}}" value=""{{#unless defaulted}} checked{{/unless}} aria-label="{{i18n "labels.noAccess"}}">
              </label>
              {{#each rungs}}
              {{#if available}}
              <label class="seg" title="{{scope}}">
                <input type="radio" name="scope:{{../family}}" value="{{scope}}"{{#if checked}} checked{{/if}} aria-label="{{scope}}">
                <span class="seg-label" data-short="{{short}}">{{level}}</span>
              </label>
              {{else}}
              <span class="seg seg-missing" title="{{i18n "labels.unavailable"}}">
                <span class="seg-label" data-short="{{short}}">{{level}}</span>
              </span>
              {{/if}}
              {{/each}}
            </div>
          </fieldset>
          {{/each}}
        </div>
      </div>
      <small>{{i18n "leads.scopeLadder"}}</small>
      <div class="form-item">
        <input class="btn btn-primary" type="submit" value="{{i18n "buttons.create"}}">
      </div>
    </div>
  </form>

  <dialog id="token-secret-modal" aria-labelledby="token-secret-title">
    <div class="form-control">
      <div style="position: relative">
        <h2 id="token-secret-title">{{i18n "titles.tokenCreated"}}</h2>
        <button type="button"
          style="position:absolute;top:0;right:0"
          class="btn btn-transparent btn-small btn-inline btn-danger"
          onclick="document.querySelector('#token-secret-modal').close()"
          title="{{i18n "labels.close"}}">
          <ui-icon name="close"></ui-icon>
        </button>
      </div>
      <p role="alert">
        <span class="text-warning" style="font-size: 1.5em;"><ui-icon name="info"></ui-icon></span>
        <span>{{i18n "leads.tokenCreated"}}</span>
      </p>
      <div class="form-item">
        <div style="display:flex; gap:.5rem; align-items:center;">
          <code id="token-secret-value" style="word-break:break-all; flex:1;"></code>
          <button type="button" class="btn btn-inline" id="copy-token-secret">{{i18n "labels.copy"}}</button>
        </div>
      </div>
      <div class="form-item" style="margin-top: 15px; justify-content: end;">
        <button type="button" class="btn btn-main" id="close-token-secret">{{i18n "labels.close"}}</button>
      </div>
    </div>
  </dialog>

  <form id="token-filters" method="get" class="token-filters">
    <input type="hidden" name="filter" value="1">
    <label><input type="checkbox" name="personal" onchange="this.form.requestSubmit()" {{#if showPersonal}}checked{{/if}}> {{i18n "labels.personalTokens"}}</label>
    <label><input type="checkbox" name="oauth" onchange="this.form.requestSubmit()" {{#if showOauth}}checked{{/if}}> {{i18n "labels.oauthTokens"}}</label>
  </form>

  <div class="list-table-wrap">
  <table class="list-table">
    <thead>
      <tr>
        <th>{{i18n "fields.name"}}</th>
        <th>{{i18n "labels.scope"}}</th>
        <th>client</th>
        <th>{{i18n "fields.ctime"}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="token-list">
      {{#each tokens}}
      <tr>
        <td>{{name}}</td>
        <td>
          <ul class="scope-list">
            {{#each scope}}<li>{{this}}</li>{{/each}}
          </ul>
        </td>
        <td>{{#if clientName}}{{clientName}}{{else}}—{{/if}}</td>
        <td>{{dateString created "date"}}</td>
        <td><button type="button" class="btn btn-danger" data-token-id="{{id}}">{{i18n "labels.revoke"}}</button></td>
      </tr>
      {{else}}
      <tr><td colspan="5" style="text-align: center">{{i18n "leads.noTokens"}}</td></tr>
      {{/each}}
    </tbody>
  </table>
  </div>

  <script>
    (function manageTokens(){
      const list = document.querySelector("#token-list");
      const form = document.querySelector("#token-create");
      const secretModal = document.querySelector("#token-secret-modal");
      const secretValue = document.querySelector("#token-secret-value");
      const copyBtn = document.querySelector("#copy-token-secret");

      copyBtn.addEventListener("click", async ()=>{
        try{
          await navigator.clipboard.writeText(secretValue.innerText);
          const label = copyBtn.innerText;
          copyBtn.innerText = `{{i18n "labels.copied"}}`;
          setTimeout(()=>{ copyBtn.innerText = label; }, 1500);
        }catch(e){ console.error("Failed to copy token:", e); }
      });
      document.querySelector("#close-token-secret").addEventListener("click", ()=>secretModal.close());
      //The list is server-rendered: once the one-time secret is dismissed
      //(button or Esc), reload so the new token shows up
      secretModal.addEventListener("close", ()=>location.reload());

      const allBox = form.querySelector('input[name="scope"][value="all"]');
      const tracks = Array.from(form.querySelectorAll(".scope-track"));
      let savedScopes = [];
      function syncScopes(){
        if(allBox.checked){
          //Remember each family's selection, then show every track filled to
          //its highest mintable level, disabled
          savedScopes = tracks.map((t)=>t.querySelector("input:checked")?.value ?? "");
          for(const t of tracks){
            const levels = Array.from(t.querySelectorAll("input"));
            levels[levels.length - 1].checked = true;
            for(const l of levels) l.disabled = true;
          }
        }else{
          //Restore interactive mode and the previous selection
          tracks.forEach((t, i)=>{
            t.querySelectorAll("input").forEach((l)=>{
              l.disabled = false;
              l.checked = savedScopes[i] !== undefined ? l.value === savedScopes[i] : l.defaultChecked;
            });
          });
        }
      }
      allBox.addEventListener("change", syncScopes);
      syncScopes();

      //Double action: clicking the level that is already selected toggles
      //just that level off, stepping the family down to the previous one
      //(admin → write → read → origin). Native radios cannot be deselected,
      //so the pre-click state is captured on the label's pointerdown, and the
      //step-down happens on the input's synthesized click — the last step of
      //label activation, after which nothing re-checks the radio.
      for(const t of tracks){
        const levels = Array.from(t.querySelectorAll("input")); //origin first
        for(const label of t.querySelectorAll("label.seg")){
          const input = label.querySelector("input");
          let wasChecked = false;
          label.addEventListener("pointerdown", ()=>{ wasChecked = input.checked; });
          input.addEventListener("click", ()=>{
            if(wasChecked && !input.disabled) levels[levels.indexOf(input) - 1].checked = true;
            wasChecked = false;
          });
        }
      }

      for(const btn of list.querySelectorAll("button[data-token-id]")){
        btn.addEventListener("click", ()=>{
          fetch(`/auth/tokens/${encodeURIComponent(btn.dataset.tokenId)}`, {method: "DELETE"}).then((r)=>{
            if(!r.ok) throw new Error(r.statusText);
            location.reload();
          }).catch((e)=>console.error("Failed to revoke token:", e));
        });
      }

      form.onsubmit = (ev)=>{
        ev.preventDefault();
        //Each track submits only its selected (highest) level. With no
        //explicit grant at all, fall back to the implicit floor every
        //credential carries anyway: a pure identity token
        const picked = tracks.map((t)=>t.querySelector("input:checked")?.value).filter((v)=>v);
        fetch("/auth/tokens", {
          method: "POST",
          headers: {"Content-Type": "application/json", "Accept": "application/json"},
          body: JSON.stringify({
            name: form.name.value,
            scope: allBox.checked ? ["all"] : (picked.length ? picked : ["corpus:read"]),
          }),
        }).then(async (r)=>{
          const body = await r.json();
          if(!r.ok) throw new Error(body.message ?? JSON.stringify(body));
          //The secret is shown exactly once and never persisted client-side;
          //dismissing the modal reloads the page with the new token listed
          secretValue.innerText = body.token;
          secretModal.showModal();
        }).catch((e)=>console.error("Failed to create token:", e));
        return false;
      };
    })();
  </script>
</section>

<section class="user-grants" style="margin-top: 2rem;">
  <h3>{{i18n "titles.authorizedApps"}}</h3>
  <p>{{i18n "leads.authorizedApps"}}</p>

  <div class="list-table-wrap">
  <table class="list-table">
    <thead>
      <tr>
        <th>{{i18n "labels.clientName"}}</th>
        <th>{{i18n "labels.scope"}}</th>
        <th>{{i18n "fields.ctime"}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="grant-list"></tbody>
  </table>
  </div>

  <script>
    (function manageGrants(){
      const list = document.querySelector("#grant-list");

      function refresh(){
        fetch("/auth/oauth/grants", {headers: {"Accept": "application/json"}}).then(async (r)=>{
          if(!r.ok) throw new Error(await r.text());
          const grants = await r.json();
          if(grants.length === 0){
            const tr = document.createElement("tr");
            const td = document.createElement("td");
            td.colSpan = 4;
            td.style.textAlign = "center";
            td.innerText = `{{i18n "leads.noAuthorizedApps"}}`;
            tr.appendChild(td);
            list.replaceChildren(tr);
            return;
          }
          list.replaceChildren(...grants.map((g)=>{
            const tr = document.createElement("tr");
            const scopes = document.createElement("ul");
            scopes.className = "scope-list";
            scopes.replaceChildren(...g.scope.map((s)=>{
              const li = document.createElement("li");
              li.innerText = s;
              return li;
            }));
            for(const content of [g.client_name, scopes, new Date(g.created).toLocaleDateString()]){
              const td = document.createElement("td");
              td.append(content);
              tr.appendChild(td);
            }
            const td = document.createElement("td");
            const btn = document.createElement("button");
            btn.className = "btn btn-danger";
            btn.innerText = `{{i18n "labels.revoke"}}`;
            btn.title = `{{i18n "leads.revokeGrant"}}`;
            btn.onclick = ()=>{
              fetch(`/auth/oauth/grants/${encodeURIComponent(g.client_id)}`, {method: "DELETE"}).then(refresh);
            };
            td.appendChild(btn);
            tr.appendChild(td);
            return tr;
          }));
        }).catch((e)=>console.error("Failed to fetch grants:", e));
      }

      refresh();
    })();
  </script>
</section>
