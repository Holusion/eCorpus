
<section class="user-form">
  {{> otherAccountWarning}}
  <submit-fragment class="form-control" action="/users/{{account.uid}}" method="PATCH" encoding="application/json">
    <form id="user-profile" autocomplete="off" aria-labelledby="user-profile-header">
      <div class="form-group">
        <h3 id="user-profile-header">{{i18n "titles.userProfile"}}</h3>
      </div>
      <input type="hidden" name="uid" value="{{account.uid}}"/>
      <div class="form-group">
        <div class="form-item">
          <label for="username">{{i18n "labels.username"}}</label>
          <input type="text" autocomplete="username" minlength="3" name="username" id="username" placeholder="{{i18n "labels.username"}}"
            value="{{ account.username }}">
        </div>
      </div>
      <div class="form-group">
        <div class="form-item">
          <label for="email">{{i18n "labels.email"}}</label>
          <input type="email" autocomplete="email" name="email" id="email" placeholder="{{i18n "labels.email"}}"
            value="{{ account.email }}">
        </div>
      </div>
      <div class="form-group">
        <input class="btn btn-main" type="submit" value="{{i18n "labels.save"}}">
      </div>
    </form>
  </submit-fragment>


  <submit-fragment class="form-control" action="/users/{{account.uid}}" method="PATCH" encoding="application/json">
    <form id="user-password" aria-labelledby="user-password-header">
      <div class="form-group">
        <h3 id="user-password-header">{{i18n "titles.changePassword"}}</h3>
      </div>
      <input type="hidden" name="username" id="username" value="{{account.username}}">
      <div class="form-group">
        <div class="form-item">
          <label for="password">{{i18n "labels.newPassword"}}</label>
          <input type="password" autocomplete="new-password" minlength="8" name="password" id="password"
            placeholder="{{i18n "labels.newPassword"}}" required>
        </div>
      </div>
      <div class="form-group">
        <input class="btn btn-main" type="submit" name="password-submit" value="{{i18n "labels.save"}}">
      </div>
    </form>
  </submit-fragment>

  {{!-- Who logs out is who's logged in: an admin on someone else's page is themself --}}
  {{#if isSelf}}
  <div style="padding-top:15px; max-width:500px">
    <h3>{{i18n "buttons.logout"}}</h3>
    <form id="user-logout" class="form-control" method="POST" action="/auth/logout">
      <input type="hidden" name="redirect" value="/ui/"/>
      <div class="form-group">
        <button role="submit" class="btn btn-main">{{i18n "buttons.logout"}}</button>
      </div>
    </form>
  </div>
  {{/if}}
</section>