
  <h1>{{#if brand}}{{brand}}{{else}}eCorpus{{/if}}: {{i18n "titles.upload"}}</h1>
<div class="grid-content">
  
  {{!-- What's been started from here, until it's been read: drawn by the server, kept up to date by the browser (see activity/page.ts).
    Always there, so that what's started can show in it: hidden while it's empty. --}}
  <section class="container notifications-page" aria-labelledby="createdScenes-heading"{{#unless uploads.length}} hidden{{/unless}}>
    <h3 id="createdScenes-heading">{{i18n "titles.createdScenes" }}</h3>
    <ul class="notifications-list" data-notifications data-unread-only data-follow="{{uploadTasks}}">
      {{#each uploads}}
        {{> notification }}
      {{/each}}
    </ul>
  </section>
  <section class="container">
    <upload-manager class="form-control">

      <h3 slot="title" id="upload-form-title" class="form-title">{{i18n "titles.createOrUpdateScene"}}</h3>

      <span slot="drop-label">{{i18n "labels.selectFile_s"}}</span>

      <div slot="upload-lead">
        <aside class="help-block">
          <ui-icon name="info"></ui-icon>
          <div class="help-block-content">
            <h4>{{i18n "onboarding.upload.title"}}</h4>
            <p>{{{i18n "onboarding.upload.lead"}}}</p>
          </div>
        </aside>

        <h3>{{i18n "onboarding.upload.types"}}</h3>
        <h4>{{i18n "onboarding.upload.glb.title"}}</h4>
        <p>{{{i18n "onboarding.upload.glb.lead"}}}</p>
        <aside class="help-block">
          <ui-icon name="info"></ui-icon>
          <div class="help-block-content">
            <h4>{{{i18n "onboarding.upload.optimize.title"}}}</h4>
            <p>{{{i18n "onboarding.upload.optimize.lead"}}}</p>
          </div>
        </aside>
        <h4>{{i18n "onboarding.upload.zip.title"}}</h4>
        <p>{{{i18n "onboarding.upload.zip.lead"}}}</p>

        <p style="text-align: right">
          <a href="https://ecorpus.eu/{{lang}}/doc/tutorials/import.html">{{i18n "onboarding.import.link"}} →</a>
        </p>

      </div>

      <p slot="mixed-content-warning">{{i18n "leads.uploadMixedContent"}}</p>

      <form slot="upload-form" class="form-control form-grid" aria-labelledby="upload-form-title">
        <div class="form-row">

          <div class="form-group">
            <div class="form-item">
              <label for="sceneName">{{i18n "labels.sceneName"}}</label>
              <input id="sceneName" autocomplete="off" minlength="3" type="text" name="name">
            </div>
            <small>{{i18n "leads.uploadName"}}</small>
          </div>

          <div class="form-group">
            <div class="form-item">
              <label for="sceneSetupLanguage">{{i18n "labels.setupLocalization"}}</label>
              <select name="language" id="sceneSetupLanguage" >
                {{#each languages}}
                <option {{#if selected}}selected{{/if}} value="{{code}}">{{i18n key}}</option>
                {{/each}}
              </select>
            </div>
            <small>{{i18n "leads.uploadLanguage"}}</small>
          </div>

        </div>

        <div class="form-row">
          <h4>{{i18n "titles.advancedConfiguration"}}</h4>
          <div class="form-item">
            <label for="sceneOptimize">{{i18n "labels.optimizeModel"}}</label>
            <input id="sceneOptimize" type="checkbox" name="optimize"/>
          </div>
          <small>{{i18n "leads.uploadOptimize"}}</small>
        </div>

      </form>

      <button slot="submit-scenes" role="submit" class="btn btn-main">{{i18n "buttons.uploadScene"}}</button>
      <button slot="submit-archives" role="submit" class="btn btn-main">{{i18n "buttons.uploadArchive"}}</button>
      <span slot="upload-errors">{{i18n "leads.uploadErrors"}}</span>
    </upload-manager>

  </section>
</div>
